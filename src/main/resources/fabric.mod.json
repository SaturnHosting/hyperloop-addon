  "name": "Saturn Hyperloop",
  "description": "Client for Saturn's hyperloop network.",
  "authors": [
    "aze"
  ],
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "dev.saturn.hyperloop.Hyperloop"
    ]
